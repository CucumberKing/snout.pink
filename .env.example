# Snout Pink - Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────────────────────
# Domain Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Your domain (used by Caddy for automatic HTTPS)
DOMAIN=snout.pink

# ─────────────────────────────────────────────────────────────────────────────
# WebAuthn / Passkey Configuration
# IMPORTANT: These must match your domain exactly for passkeys to work!
# ─────────────────────────────────────────────────────────────────────────────
# Relying Party ID - your domain without protocol (e.g., snout.pink)
RP_ID=snout.pink

# Relying Party Name - display name shown during passkey registration
RP_NAME=Snout Pink

# Relying Party Origin - full URL with protocol (must match exactly)
RP_ORIGIN=https://snout.pink

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB (only needed if using external MongoDB, otherwise uses Docker internal)
# ─────────────────────────────────────────────────────────────────────────────
# MONGO_URI=mongodb://user:password@host:27017/snout?authSource=admin

# ─────────────────────────────────────────────────────────────────────────────
# Session Configuration
# ─────────────────────────────────────────────────────────────────────────────
# SESSION_TTL_SECONDS=604800  # 7 days default
# SESSION_COOKIE_NAME=session

# ─────────────────────────────────────────────────────────────────────────────
# Logo.dev API (get your token at https://logo.dev)
# ─────────────────────────────────────────────────────────────────────────────
LOGO_DEV_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Legal / About URLs (optional - leave empty to hide links)
# ─────────────────────────────────────────────────────────────────────────────
# IMPRINT_URL=https://example.com/impressum
# PRIVACY_URL=https://example.com/datenschutz
# GITHUB_URL=https://github.com/your-username/snout.pink
